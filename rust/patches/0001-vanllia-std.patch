diff --git a/library/std/src/sys/alloc/vanllia/mod.rs b/library/std/src/sys/alloc/vanllia/mod.rs
new file mode 100644
--- /dev/null
+++ b/library/std/src/sys/alloc/vanllia/mod.rs
@@ -0,0 +1,103 @@
+//! Page-backed first allocator: no fixed heap, allocator locks or service calls.
+//! Each allocation retains its source and mapping until deallocation. This is
+//! deliberately a single-thread implementation with task-owned Kernel handles.
+use crate::{alloc::Layout, ptr};
+use kernel_api::model::{
+    identity::{PieToken, TeamId, VirtAddr},
+    memory::{
+        AcquireSource, Allocation, FlatReference, PAGE_SIZE, Placement, ReferenceRange,
+        ViewControl, ViewId, ViewSelection,
+    },
+};
+use kernel_client::call::memory;
+
+#[derive(Clone, Copy)]
+struct Header {
+    reference: FlatReference,
+    view: ViewId,
+}
+
+fn cleanup_failure() -> ! {
+    crate::sys::abort_internal()
+}
+
+pub unsafe fn alloc(layout: Layout) -> *mut u8 {
+    let align = layout.align().max(align_of::<Header>());
+    let Some(prefix) = size_of::<Header>().checked_next_multiple_of(align) else {
+        return ptr::null_mut();
+    };
+    let Some(size) = prefix
+        .checked_add(layout.size())
+        .and_then(|n| n.checked_next_multiple_of(PAGE_SIZE))
+    else {
+        return ptr::null_mut();
+    };
+    if size > isize::MAX as usize {
+        return ptr::null_mut();
+    }
+    let Some(allocation) = Allocation::new(size, PAGE_SIZE) else {
+        return ptr::null_mut();
+    };
+    let Some(placement) = Placement::lowest(align.max(PAGE_SIZE)) else {
+        return ptr::null_mut();
+    };
+    let Ok(reference) = memory::acquire(AcquireSource::Allocation(allocation), PieToken::NONE)
+    else {
+        return ptr::null_mut();
+    };
+    // All validation precedes acquisition. These word arrays are the Kernel
+    // API's codecs, not the in-memory layout of its Rust descriptor structs.
+    let range = ReferenceRange {
+        reference,
+        offset: 0,
+        count: size / PAGE_SIZE,
+    }
+    .encode();
+    let placement = placement.encode();
+    let attached = memory::attach(
+        VirtAddr::new(range.as_ptr() as usize),
+        TeamId::new(0),
+        VirtAddr::new(placement.as_ptr() as usize),
+        6,
+        ViewControl::Caller,
+    );
+    let (view, address) = match attached {
+        Ok(value) => value,
+        Err(_) => {
+            if memory::release(reference).is_err() {
+                cleanup_failure()
+            }
+            return ptr::null_mut();
+        }
+    };
+    let data = unsafe { (address.get() as *mut u8).add(prefix) };
+    unsafe {
+        data.sub(size_of::<Header>())
+            .cast::<Header>()
+            .write(Header { reference, view });
+    }
+    data
+}
+
+pub unsafe fn dealloc(data: *mut u8, _layout: Layout) {
+    let header = unsafe { data.sub(size_of::<Header>()).cast::<Header>().read() };
+    // Copy metadata first: Detach makes the header itself inaccessible.
+    if memory::detach(TeamId::new(0), header.view, ViewSelection::Whole).is_err() {
+        cleanup_failure()
+    }
+    if memory::release(header.reference).is_err() {
+        cleanup_failure()
+    }
+}
+
+pub unsafe fn alloc_zeroed(layout: Layout) -> *mut u8 {
+    let data = unsafe { alloc(layout) };
+    if !data.is_null() {
+        unsafe { data.write_bytes(0, layout.size()) };
+    }
+    data
+}
+
+pub unsafe fn realloc(data: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+    unsafe { super::realloc_fallback(data, layout, size) }
+}
